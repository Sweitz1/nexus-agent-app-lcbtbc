# Venice Private LLM — Environment Config
# Copy to .env and fill in your values

# API auth key — clients must send this as: Authorization: Bearer <key>
VENICE_API_KEY=changeme-set-in-env

# Your server's domain name (for SSL cert)
DOMAIN=localhost

# Allowed CORS origins (comma-separated, * = any)
ALLOW_ORIGINS=*

# Max tokens per response
MAX_TOKENS=8192
