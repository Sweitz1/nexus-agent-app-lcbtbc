{
  "appId": "com.nexusagent.app",
  "productName": "Nexus Agent",
  "copyright": "Copyright \u00a9 2026 Nexus Agent",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "electron-main.js",
    "assets/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "msi",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "msi": {
    "oneClick": false,
    "perMachine": false,
    "runAfterFinish": true,
    "shortcutName": "Nexus Agent"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "runAfterFinish": true,
    "shortcutName": "Nexus Agent"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Utility",
    "icon": "assets/icon.png",
    "synopsis": "Local-first AI agent",
    "maintainer": "Nexus Agent <nexus-agent@users.noreply.github.com>"
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0"
    ]
  }
}
